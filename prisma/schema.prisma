// Prisma schema inicial

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models de autentica��o

enum Status {
  ATIVO
  INATIVO
}

// Formas de pagamento compatíveis com Asaas billingType
// Referência: https://docs.asaas.com/reference/criar-nova-cobranca
// Apenas 4 tipos suportados pelo Asaas em pagamentos básicos
enum FormaPagamento {
  BOLETO // Sincronizado com BOLETO do Asaas - "Boleto Bancário / Pix"
  PIX // Sincronizado com PIX do Asaas - "Pix"
  CARTAO_CREDITO // Sincronizado com CREDIT_CARD do Asaas - "Cartão de Crédito"
  INDEFINIDO // Sincronizado com UNDEFINED do Asaas - "Pergunte ao cliente"
}

// Lancamentos financeiros (Receita/Despesa)
enum TipoLancamento {
  RECEITA
  DESPESA
}

enum OrigemLancamento {
  SISTEMA
  MANUAL
}

enum StatusLancamento {
  RECEBIDO
  PREVISTO
  PAGO
  PENDENTE
  ESTORNADO
}

enum FormaPagamentoLancamento {
  PIX
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  TRANSFERENCIA
  TED
  DOC
  DEBITO_AUTOMATICO
  CHEQUE
  VOUCHER
  OUTRO
}

enum CentroCustoTipo {
  RECEITA
  DESPESA
  MISTO
}

enum StatusMatricula {
  PENDENTE_TAXA
  AGUARDANDO_CONFIRMACAO
  ATIVA
  PAUSADA
  RECUSADA
  CANCELADA
}

enum StatusTaxaMatricula {
  PENDENTE
  PAGO
  EXPIRADO
  ISENTO
}

enum TipoCobranca {
  TAXA_MATRICULA
  MENSALIDADE
  EXTRA
  AVULSA // Sincronizado com DETACHED do Asaas
  PARCELADA // Sincronizado com INSTALLMENT do Asaas
  RECORRENTE // Sincronizado com RECURRENT do Asaas
}

enum StatusCobranca {
  A_VENCER // Cobrança criada, vencimento futuro
  PENDENTE // Vencimento chegou, aguardando pagamento
  PROCESSANDO // Pagamento em análise/processamento
  PAGO // Pagamento confirmado
  ATRASADO // Vencimento passou, sem pagamento
  CANCELADO // Cobrança cancelada
  ESTORNADO // Pagamento estornado/reembolsado
  ESTORNADO_PARCIAL // Estorno parcial do pagamento
}

enum StatusFinanceiro {
  ADIMPLENTE
  PENDENTE_TAXA
  INADIMPLENTE
}

enum StatusContrato {
  ATIVO
  ENCERRADO
}

enum AsaasNotificationEvent {
  PAYMENT_CREATED
  PAYMENT_UPDATED
  PAYMENT_DUEDATE_WARNING
  SEND_LINHA_DIGITAVEL
  PAYMENT_OVERDUE
  PAYMENT_RECEIVED
}

enum PeriodicidadePlano {
  SEMANAL
  QUINZENAL
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum Role {
  ADMIN
  FINANCEIRO
  RECEPCAO
  PROFESSOR
  RESPONSAVEL
}

enum Genero {
  MASCULINO
  FEMININO
  NAO_BINARIO
  OUTRO
  PREFERE_NAO_INFORMAR
}

// --- Colaboradores ---

enum CargoColaborador {
  PROFESSOR
  RECEPCAO
  FINANCEIRO
  ADMINISTRATIVO
  OUTRO
}

enum StatusColaborador {
  ATIVO
  INATIVO
}

model Colaborador {
  id      String @id @default(cuid())
  contaId String

  // Identificação
  foto       String?
  nome       String
  nomeSocial String?
  dataNasc   DateTime?
  genero     Genero?

  // Documentos
  cpf          String?
  rg           String?
  orgaoEmissor String?
  dataEmissao  DateTime?

  // Contato
  email                     String?
  telefone1                 String?
  contatoEmergenciaTelefone String?

  // Endereço
  enderecoCep         String? @db.Char(8)
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String? @db.Char(2)

  // Vínculo
  cargo            CargoColaborador
  especialidade    String?
  status           StatusColaborador @default(ATIVO)
  dataAdmissao     DateTime?
  dataDesligamento DateTime?
  observacoes      String?
  salario          Decimal?          @db.Decimal(12, 2)

  // Acesso ao sistema
  temAcesso Boolean  @default(false)
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conta Conta @relation(fields: [contaId], references: [id])

  // Unicidade por conta (multi-tenant)
  @@unique([contaId, cpf])
  @@unique([contaId, email])
  @@index([contaId])
}

model Conta {
  id                          String          @id @default(cuid())
  nome                        String
  cpfCnpj                     String
  status                      Status          @default(ATIVO)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  // Dono (owner) da conta — imutável na lógica de negócio
  ownerUserId                 String?
  ownerUser                   Usuario?        @relation("ContaOwner", fields: [ownerUserId], references: [id])
  usuarios                    Usuario[]       @relation("ContaUsuarios")
  invites                     Invite[]
  alunos                      Aluno[]
  turmas                      Turma[]
  planos                      Plano[]
  combos                      Combo[]
  descontos                   Desconto[]
  webhooks                    WebhookAsaas[]
  logsFinanceiros             LogFinanceiro[]
  logsIntegracao              LogIntegracao[]
  asaasNotificationPreferences AsaasNotificationPreference[]
  professores                 Professor[]
  colaboradores               Colaborador[]
  modalidades                 Modalidade[]
  salas                       Sala[]
  lancamentos                 Lancamento[]
  centrosCusto                CentroCusto[]
  categoriasLancamento        CategoriaLancamento[]
  // Campos de endereco da conta (escola)
  enderecoCep                 String?         @db.Char(8)
  enderecoLogradouro          String?
  enderecoNumero              String?
  enderecoBairro              String?
  enderecoCidade              String?
  enderecoUf                  String?         @db.Char(2)
  // Credenciais de integração (criptografadas em repouso). Armazenamos separadamente para permitir rotação.
  asaasApiKeyEncrypted        String?
  asaasWebhookSecretEncrypted String?
  asaasCredsUpdatedAt         DateTime?

  @@index([cpfCnpj])
  @@index([ownerUserId])
}

model AsaasNotificationPreference {
  id                     String                 @id @default(cuid())
  contaId                String
  event                  AsaasNotificationEvent
  scheduleOffset         Int                    @default(0)
  enabled                Boolean                @default(true)
  emailEnabledForProvider Boolean               @default(false)
  smsEnabledForProvider   Boolean               @default(false)
  emailEnabledForCustomer Boolean               @default(true)
  smsEnabledForCustomer   Boolean               @default(true)
  whatsappEnabledForCustomer Boolean            @default(false)
  phoneCallEnabledForCustomer Boolean           @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@unique([contaId, event, scheduleOffset])
  @@index([contaId])
}

/// Modelo de Professor com foco em multi-tenant via contaId.
/// Decisões:
/// - status como String com default "ATIVO" (evita acoplamento a enum para flexibilidade futura).
/// - email opcional porém único globalmente (Postgres permite vários NULLs em índice único).
/// - nome terá validação de tamanho mínimo (>= 2) aplicada na camada de aplicação (Zod), não no schema.
/// - Relação futura com TurmaProfessor (campo `turmas`) ficará comentada até o modelo existir.
enum StatusContratual {
  EFETIVO
  TEMPORARIO
  PRESTADOR
  VOLUNTARIO
}

model Professor {
  id      String @id @default(cuid())
  contaId String

  // Dados pessoais
  nome          String
  cpf           String   @unique
  rg            String?
  dataNasc      DateTime
  sexo          String?
  estadoCivil   String?
  nacionalidade String?

  // Contato
  email        String  @unique
  telefoneCel  String
  telefoneFixo String?

  // Endereço
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.Char(2)

  // Profissional
  formacao         String?
  especialidades   String[]          @default([])
  dataAdmissao     DateTime?
  statusContratual StatusContratual?
  cargaHoraria     Int?
  miniBio          String?
  foto             String?

  status    Status   @default(ATIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conta  Conta            @relation(fields: [contaId], references: [id])
  turmas TurmaProfessor[]

  @@index([contaId], name: "idx_professor_conta")
}

model Usuario {
  id          String   @id @default(cuid())
  contaId     String
  conta       Conta    @relation("ContaUsuarios", fields: [contaId], references: [id])
  // Backrelation: contas onde este usuário é o owner
  ownedContas Conta[]  @relation("ContaOwner")
  nome        String
  email       String   @unique
  telefone    String?
  foto        String?
  bio         String?
  locale      String   @default("pt-BR")
  theme       String   @default("system")
  notifyEmailProduct   Boolean  @default(true)
  notifyEmailSecurity  Boolean  @default(true)
  notifyEmailMarketing Boolean  @default(false)
  notifyWhatsapp       Boolean  @default(true)
  notifySms            Boolean  @default(false)
  senhaHash   String
  role        Role     @default(RESPONSAVEL)
  status      Status   @default(ATIVO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  colaborador          Colaborador?
  // Backrelation para vínculo opcional com Responsavel (1-1)
  responsavel          Responsavel?
  // Backrelation para vínculo opcional com Aluno (1-1)
  aluno                Aluno?
  checkoutLinksCriados CheckoutLink[]
  matriculaLogs        MatriculaLog[]
  logsFinanceiros      LogFinanceiro[]
  lancamentosCriados   Lancamento[]

  @@index([contaId])
}

// --- Modelos de dom�nio Escola ---

model Aluno {
  id                        String    @id @default(cuid())
  contaId                   String
  nome                      String
  nomeSocial                String?
  dataNasc                  DateTime
  cpf                       String?   @unique
  email                     String?
  telefone                  String?
  foto                      String?
  // Vinculação opcional com um usuário do sistema (para acesso/portal do aluno)
  usuarioId                 String?   @unique
  usuario                   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  // Campos de endere�o estruturados
  enderecoCep               String?   @db.Char(8)
  enderecoLogradouro        String?
  enderecoNumero            String?
  enderecoComplemento       String?
  enderecoBairro            String?
  enderecoCidade            String?
  enderecoUf                String?   @db.Char(2)
  observacao                String?
  genero                    Genero?
  modalidadePrincipal       String?
  nivel                     String?
  alergias                  String?
  restricoesMedicas         String?
  contatoEmergenciaNome     String?
  contatoEmergenciaTelefone String?
  origemCadastro            String?
  bolsaDescontoPercent      Decimal?  @db.Decimal(5, 2)
  isentoTaxaMatricula       Boolean   @default(false)
  consentimentoImagem       Boolean   @default(false)
  dataConsentimentoImagem   DateTime?
  consentimentoComunicacoes Boolean   @default(true)
  tamanhoCamiseta           String?
  tamanhoCalcado            String?
  codigoInterno             String?
  tags                      String[]  @default([])
  status                    Status    @default(ATIVO)
  asaasId                   String?   @unique
  asaasCustomerId           String?   @unique
  dataInativacao            DateTime?
  motivoInativacao          String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  conta        Conta              @relation(fields: [contaId], references: [id])
  responsaveis AlunoResponsavel[]
  matriculas   Matricula[]

  @@unique([contaId, email])
  @@unique([contaId, codigoInterno])
  @@index([contaId])
}

model Responsavel {
  id                   String   @id @default(cuid())
  nome                 String
  cpf                  String   @unique
  email                String   @unique
  telefone             String
  // Campos de endere�o estruturados
  enderecoCep          String?
  enderecoLogradouro   String?
  enderecoNumero       String?
  enderecoComplemento  String?
  enderecoBairro       String?
  enderecoCidade       String?
  enderecoUf           String?
  financeiro           Boolean  @default(false)
  asaasId              String?  @unique
  asaasCustomerId      String?  @unique
  asaasCreditCardToken String? // Token do cartão para débito automático
  // Metadados do cartão (para exibição, não contém dados sensíveis)
  creditCardBrand      String? // Bandeira do cartão (Visa, Mastercard, etc)
  creditCardLast4      String? // Últimos 4 dígitos
  creditCardExpiryMonth Int? // Mês de expiração (1-12)
  creditCardExpiryYear  Int? // Ano de expiração (4 dígitos)
  creditCardUpdatedAt   DateTime? // Data da última atualização do cartão
  preferredBillingType  String? // Tipo de cobrança preferido (BOLETO, PIX, CREDIT_CARD)
  // Vinculação opcional com um usuário do sistema (para acesso via portal)
  usuarioId            String?  @unique
  usuario              Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  alunos                AlunoResponsavel[]
  matriculasFinanceiras Matricula[]        @relation("MatriculaResponsavelFinanceiro")
}

model AlunoResponsavel {
  id            String @id @default(cuid())
  alunoId       String
  responsavelId String
  tipoVinculo   String

  aluno       Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavel Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([responsavelId])
}

model Turma {
  id           String   @id @default(cuid())
  contaId      String
  nome         String
  modalidadeId String
  salaId       String
  diasSemana   String[]
  horaInicio   String
  horaFim      String
  idadeMin     Int?
  idadeMax     Int?
  capacidade   Int
  status       String   @default("ATIVO")
  observacao   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conta       Conta            @relation(fields: [contaId], references: [id])
  modalidade  Modalidade       @relation(fields: [modalidadeId], references: [id])
  sala        Sala             @relation(fields: [salaId], references: [id])
  matriculas  Matricula[]
  combos      ComboTurma[]
  professores TurmaProfessor[]
  matriculaTurmas MatriculaTurma[]

  @@unique([contaId, nome], name: "uq_turma_conta_nome")
  @@index([contaId], name: "idx_turma_conta")
  @@index([modalidadeId])
  @@index([salaId])
}

model Modalidade {
  id        String   @id @default(cuid())
  contaId   String
  nome      String
  descricao String?
  status    String   @default("ATIVO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conta  Conta   @relation(fields: [contaId], references: [id])
  turmas Turma[]

  @@unique([contaId, nome], name: "uq_modalidade_conta_nome")
  @@index([contaId], name: "idx_modalidade_conta")
}

model Sala {
  id         String   @id @default(cuid())
  contaId    String
  nome       String
  descricao  String?
  capacidade Int
  status     Status   @default(ATIVO)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conta  Conta   @relation(fields: [contaId], references: [id])
  turmas Turma[]

  @@unique([contaId, nome], name: "uq_sala_conta_nome")
  @@index([contaId], name: "idx_sala_conta")
}

model TurmaProfessor {
  id          String   @id @default(cuid())
  turmaId     String
  professorId String
  createdAt   DateTime @default(now())

  turma     Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id])

  @@unique([turmaId, professorId], name: "uq_turmaprofessor_unique")
  @@index([turmaId], name: "idx_turmaprofessor_turma")
  @@index([professorId], name: "idx_turmaprofessor_professor")
}

model Plano {
  id            String             @id @default(cuid())
  contaId       String
  nome          String
  descricao     String?
  periodicidade PeriodicidadePlano @default(MENSAL)
  valor         Decimal            @db.Decimal(12, 2)
  status        Status             @default(ATIVO)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  conta      Conta       @relation(fields: [contaId], references: [id])
  matriculas Matricula[]

  @@unique([contaId, nome], name: "uq_plano_conta_nome")
  @@index([contaId], name: "idx_plano_conta")
}

model Matricula {
  id                      String              @id @default(cuid())
  alunoId                 String
  responsavelFinanceiroId String?
  turmaId                 String?
  planoId                 String?             // Opcional quando comboId é fornecido (combo define valor/periodicidade)
  comboId                 String?
  dataInicio              DateTime
  dataFim                 DateTime?
  dataFimContrato         DateTime
  status                  StatusMatricula     @default(ATIVA)
  statusFinanceiro        StatusFinanceiro    @default(PENDENTE_TAXA)
  statusContrato          StatusContrato      @default(ATIVO)
  taxaMatricula           Decimal             @db.Decimal(12, 2)
  taxaStatus              StatusTaxaMatricula @default(PENDENTE)
  taxaIsenta              Boolean             @default(false)
  taxaJustificativa       String?
  formaPagamentoTaxa      FormaPagamento?     @default(BOLETO)
  vencimentoDia           Int                 @default(5)
  // Configurações financeiras de juros, multa e desconto (padrão Asaas API)
  // @see https://docs.asaas.com/docs/criando-uma-assinatura
  jurosMensal             Decimal?            @db.Decimal(5, 2) // Ex: 1.0 = 1% ao mês
  jurosTipo               String?             @default("PERCENTAGE") // FIXED ou PERCENTAGE (Asaas)
  multaPercentual         Decimal?            @db.Decimal(5, 2) // Ex: 2.0 = 2%
  multaTipo               String?             @default("PERCENTAGE") // FIXED ou PERCENTAGE (Asaas)
  descontoAntecipado      Decimal?            @db.Decimal(5, 2) // Ex: 5.0 = 5% de desconto
  descontoTipo            String?             @default("PERCENTAGE") // FIXED ou PERCENTAGE (Asaas)
  prazoDesconto           Int?                @default(0) // Quantos dias antes do vencimento para aplicar desconto
  asaasId                 String?             @unique
  asaasSubscriptionId     String?             @unique
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  aluno                 Aluno               @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavelFinanceiro Responsavel?        @relation("MatriculaResponsavelFinanceiro", fields: [responsavelFinanceiroId], references: [id])
  turma                 Turma?              @relation(fields: [turmaId], references: [id])
  plano                 Plano?              @relation(fields: [planoId], references: [id])
  combo                 Combo?              @relation(fields: [comboId], references: [id])
  descontos             DescontoMatricula[]
  cobrancas             Cobranca[]
  checkoutLinks         CheckoutLink[]
  logs                  MatriculaLog[]
  matriculaTurmas       MatriculaTurma[]

  @@index([alunoId], name: "idx_matricula_aluno")
  @@index([responsavelFinanceiroId], name: "idx_matricula_responsavel")
  @@index([turmaId], name: "idx_matricula_turma")
  @@index([planoId], name: "idx_matricula_plano")
  @@index([comboId], name: "idx_matricula_combo")
  @@index([status], name: "idx_matricula_status")
  @@index([statusContrato], name: "idx_matricula_status_contrato")
  @@index([dataFimContrato], name: "idx_matricula_fim_contrato")
}

model MatriculaTurma {
  id           String   @id @default(cuid())
  matriculaId  String
  turmaId      String
  createdAt    DateTime @default(now())

  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  turma     Turma     @relation(fields: [turmaId], references: [id])

  @@unique([matriculaId, turmaId], name: "uq_matriculaturma_unique")
  @@index([matriculaId], name: "idx_matriculaturma_matricula")
  @@index([turmaId], name: "idx_matriculaturma_turma")
}

model Desconto {
  id        String   @id @default(cuid())
  contaId   String
  nome      String
  tipo      String
  valor     Decimal  @db.Decimal(12, 2)
  escopo    String
  status    String   @default("ATIVO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conta      Conta               @relation(fields: [contaId], references: [id])
  matriculas DescontoMatricula[]

  @@unique([contaId, nome], name: "uq_desconto_conta_nome")
  @@index([contaId], name: "idx_desconto_conta")
}

model DescontoMatricula {
  id          String   @id @default(cuid())
  matriculaId String
  descontoId  String
  valorFinal  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  desconto  Desconto  @relation(fields: [descontoId], references: [id])

  @@unique([matriculaId, descontoId], name: "uq_descontomatricula_unique")
  @@index([matriculaId], name: "idx_descontomatricula_matricula")
  @@index([descontoId], name: "idx_descontomatricula_desconto")
}

model Combo {
  id            String             @id @default(cuid())
  contaId       String
  nome          String
  descricao     String?
  valor         Decimal            @db.Decimal(12, 2) // Valor do ciclo (conforme periodicidade)
  periodicidade PeriodicidadePlano @default(MENSAL) // Ciclo de cobrança (Asaas)
  status        String             @default("ATIVO")
  vagasLimite   Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  conta      Conta        @relation(fields: [contaId], references: [id])
  turmas     ComboTurma[]
  matriculas Matricula[]

  @@unique([contaId, nome], name: "uq_combo_conta_nome")
  @@index([contaId], name: "idx_combo_conta")
}

model ComboTurma {
  id        String   @id @default(cuid())
  comboId   String
  turmaId   String
  createdAt DateTime @default(now())

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id])

  @@index([turmaId], name: "idx_comboturma_turma")
}

model Cobranca {
  id                String         @id @default(cuid())
  matriculaId       String
  tipo              TipoCobranca   @default(MENSALIDADE)
  descricao         String?
  competenciaInicio DateTime
  competenciaFim    DateTime
  valor             Decimal        @db.Decimal(12, 2)
  vencimento        DateTime
  dataPagamento     DateTime?
  formaPagamento    FormaPagamento @default(BOLETO)
  status            StatusCobranca @default(PENDENTE)
  asaasId           String?        @unique
  asaasPaymentId    String?        @unique

  // Campos financeiros adicionais - Juros
  jurosPercentual Decimal? @default(0) @db.Decimal(5, 2) // Percentual de juros ao mês (%)
  jurosValorFixo  Decimal? @default(0) @db.Decimal(12, 2) // Valor fixo de juros ao mês (R$)
  juros           Decimal? @default(0) @db.Decimal(12, 2) // Valor total de juros acumulados

  // Campos financeiros adicionais - Multa
  multaTipo       String?  @default("VALOR_FIXO") // VALOR_FIXO ou PERCENTUAL
  multaPercentual Decimal? @default(0) @db.Decimal(5, 2) // Percentual de multa (%)
  multaValorFixo  Decimal? @default(0) @db.Decimal(12, 2) // Valor fixo da multa (R$)
  multa           Decimal? @default(0) @db.Decimal(12, 2) // Valor total da multa aplicada

  // Campos financeiros adicionais - Desconto
  descontoTipo        String?  @default("VALOR_FIXO") // VALOR_FIXO ou PERCENTUAL
  descontoPercentual  Decimal? @default(0) @db.Decimal(5, 2) // Percentual de desconto (%)
  descontoValorFixo   Decimal? @default(0) @db.Decimal(12, 2) // Valor fixo do desconto (R$)
  descontoPrazoMaximo String?  @default("ATE_VENCIMENTO") // ATE_VENCIMENTO, 1_DIA, 3_DIAS, 7_DIAS, 15_DIAS, 30_DIAS
  desconto            Decimal? @default(0) @db.Decimal(12, 2) // Valor total do desconto aplicado

  valorFinal Decimal? @db.Decimal(12, 2) // Valor final com multa, juros e desconto aplicados

  // Campos de auditoria para rastreabilidade completa
  pagoEm          DateTime? // Data/hora em que o pagamento foi confirmado
  pagoPor         String? // Forma de pagamento real utilizada (pode diferir da esperada)
  canceladoEm     DateTime? // Data/hora do cancelamento
  canceladoMotivo String? // Motivo do cancelamento
  canceladoPor    String? // Usuário ou sistema que cancelou
  estornadoEm     DateTime? // Data/hora do estorno (total ou parcial)
  estornadoMotivo String? // Motivo do estorno
  estornadoValor  Decimal?  @db.Decimal(12, 2) // Valor estornado (para estornos parciais)
  estornadoPor    String? // Usuário ou sistema que estornou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matricula       Matricula         @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  pagamentos      Pagamento[]
  logsFinanceiros LogFinanceiro[]
  arquivos        ArquivoCobranca[]

  @@index([matriculaId], name: "idx_cobranca_matricula")
  @@index([status], name: "idx_cobranca_status")
  @@index([tipo], name: "idx_cobranca_tipo")
}

model ArquivoCobranca {
  id           String   @id @default(cuid())
  cobrancaId   String
  nomeOriginal String
  nomeArquivo  String   @unique // Nome do arquivo no storage
  mimetype     String
  tamanho      Int // Em bytes
  url          String
  uploadPor    String? // ID do usuário que fez upload
  createdAt    DateTime @default(now())

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@index([cobrancaId], name: "idx_arquivo_cobranca")
}

model CheckoutLink {
  id          String    @id @default(cuid())
  matriculaId String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  channel     String    @default("PORTAL")
  createdAt   DateTime  @default(now())

  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  createdBy Usuario   @relation(fields: [createdById], references: [id])

  @@index([matriculaId], name: "idx_checkoutlink_matricula")
  @@index([expiresAt], name: "idx_checkoutlink_expiration")
}

model MatriculaLog {
  id          String   @id @default(cuid())
  matriculaId String
  action      String
  actorId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  actor     Usuario?  @relation(fields: [actorId], references: [id])

  @@index([matriculaId], name: "idx_matriculalog_matricula")
  @@index([action], name: "idx_matriculalog_action")
}

model Pagamento {
  id             String    @id @default(cuid())
  cobrancaId     String
  dataPagamento  DateTime?
  formaPagamento String
  valorPago      Decimal   @db.Decimal(12, 2)
  status         String    @default("CONFIRMADO")
  comprovante    String?
  asaasPaymentId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@index([cobrancaId], name: "idx_pagamento_cobranca")
}

model WebhookAsaas {
  id           String    @id @default(cuid())
  contaId      String
  evento       String
  eventId      String?   @unique
  payload      Json
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?
  status       String    @default("PENDENTE")

  conta Conta @relation(fields: [contaId], references: [id])

  @@index([contaId], name: "idx_webhookasaas_conta")
  @@index([status], name: "idx_webhookasaas_status")
}

model LogFinanceiro {
  id         String   @id @default(cuid())
  contaId    String
  usuarioId  String
  cobrancaId String?
  acao       String // DELETAR, PAUSAR, REENVIAR, SEGUNDA_VIA, CONFIRMAR_MANUAL, REFUND, REATIVAR
  detalhes   Json?
  createdAt  DateTime @default(now())

  conta    Conta     @relation(fields: [contaId], references: [id])
  usuario  Usuario   @relation(fields: [usuarioId], references: [id])
  cobranca Cobranca? @relation(fields: [cobrancaId], references: [id], onDelete: SetNull)

  @@index([contaId], name: "idx_logfinanceiro_conta")
  @@index([usuarioId], name: "idx_logfinanceiro_usuario")
  @@index([cobrancaId], name: "idx_logfinanceiro_cobranca")
  @@index([acao], name: "idx_logfinanceiro_acao")
  @@index([createdAt], name: "idx_logfinanceiro_createdat")
}

model LogIntegracao {
  id             String   @id @default(cuid())
  contaId        String
  tipoOperacao   String // CREATE_CUSTOMER, UPDATE_CUSTOMER, DELETE_CUSTOMER, CREATE_SUBSCRIPTION, SUSPEND_SUBSCRIPTION, ACTIVATE_SUBSCRIPTION, DELETE_SUBSCRIPTION, RECEIVE_IN_CASH, CREATE_PAYMENT, etc
  entidade       String // ALUNO, RESPONSAVEL, MATRICULA, COBRANCA
  entidadeId     String
  asaasId        String? // ID retornado pelo Asaas (customerId, subscriptionId, paymentId)
  status         String // SUCCESS, ERROR
  httpStatus     Int? // Status HTTP da resposta
  request        Json? // Payload enviado
  response       Json? // Resposta do Asaas
  errorMessage   String?
  idempotencyKey String? // Idempotency-Key usado na request
  duration       Int? // Duração da request em ms
  createdAt      DateTime @default(now())

  conta Conta @relation(fields: [contaId], references: [id])

  @@index([contaId, tipoOperacao], name: "idx_logintegracao_conta_tipo")
  @@index([entidade, entidadeId], name: "idx_logintegracao_entidade")
  @@index([status], name: "idx_logintegracao_status")
  @@index([createdAt], name: "idx_logintegracao_createdat")
  @@index([asaasId], name: "idx_logintegracao_asaasid")
}

// --- Lancamentos financeiros ---
model Lancamento {
  id             String                  @id @default(cuid())
  contaId        String
  tipo           TipoLancamento
  origem         OrigemLancamento
  status         StatusLancamento
  valor          Decimal                 @db.Decimal(14, 2)
  descricao      String
  referencia     String?
  centroCustoId  String?
  categoriaId    String?
  subcategoriaId String?
  formaPagamento FormaPagamentoLancamento?
  dataEfetiva    DateTime?
  dataPrevista   DateTime?
  isEstorno      Boolean                 @default(false)
  parentId       String?
  dataEstorno    DateTime?
  motivoEstorno  String?
  observacao     String?
  anexoUrl       String?
  externalRef    String?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  conta        Conta                  @relation(fields: [contaId], references: [id])
  centroCusto  CentroCusto?           @relation(fields: [centroCustoId], references: [id])
  categoria    CategoriaLancamento?   @relation("CategoriaLancamentoCategoria", fields: [categoriaId], references: [id])
  subcategoria CategoriaLancamento?   @relation("CategoriaLancamentoSubcategoria", fields: [subcategoriaId], references: [id])
  parent       Lancamento?            @relation("LancamentoEstorno", fields: [parentId], references: [id])
  estornos     Lancamento[]           @relation("LancamentoEstorno")
  createdBy    Usuario?               @relation(fields: [createdById], references: [id])

  @@index([contaId, tipo, status], name: "idx_lancamento_conta_tipo_status")
  @@index([contaId, dataEfetiva], name: "idx_lancamento_conta_data")
  @@index([externalRef], name: "idx_lancamento_external_ref")
}

model CentroCusto {
  id        String           @id @default(cuid())
  contaId   String
  nome      String
  tipo      CentroCustoTipo
  descricao String?
  status    Status           @default(ATIVO)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  conta        Conta        @relation(fields: [contaId], references: [id])
  lancamentos  Lancamento[]

  @@unique([contaId, nome, tipo], name: "uq_centrocusto_nome_tipo_conta")
  @@index([contaId, tipo], name: "idx_centrocusto_conta_tipo")
}

model CategoriaLancamento {
  id        String           @id @default(cuid())
  contaId   String
  nome      String
  tipo      TipoLancamento
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  conta    Conta                  @relation(fields: [contaId], references: [id])
  parent   CategoriaLancamento?   @relation("CategoriaLancParent", fields: [parentId], references: [id])
  children CategoriaLancamento[]  @relation("CategoriaLancParent")
  lancamentosCategoria    Lancamento[] @relation("CategoriaLancamentoCategoria")
  lancamentosSubcategoria Lancamento[] @relation("CategoriaLancamentoSubcategoria")

  @@unique([contaId, nome, tipo, parentId], name: "uq_categoria_lancamento_nome_tipo_parent")
  @@index([contaId, tipo], name: "idx_categoria_lancamento_conta_tipo")
}

// --- Convites de usuário ---
model Invite {
  id               String    @id @default(cuid())
  // A conta do convidador no momento da criação do convite (usada no aceite)
  contaId          String?
  email            String?   // Opcional para convites de RESPONSAVEL
  role             Role
  token            String    @unique
  invitedById      String
  status           String    @default("PENDING")
  expiresAt        DateTime
  // Auditoria de aceite
  acceptedByUserId String?
  acceptedAt       DateTime?
  metadata         Json?     // Armazena dados extras como alunosIds para RESPONSAVEL
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relação opcional para garantir integridade sem quebrar convites antigos
  conta Conta? @relation(fields: [contaId], references: [id])

  @@index([email, status], name: "idx_invite_email_status")
  @@index([expiresAt], name: "idx_invite_expires")
  @@index([contaId], name: "idx_invite_conta")
}
