{
  "name": "@alusa/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:light": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NEXT_TELEMETRY_DISABLED=1 next dev -p 3000",
    "dev:clean": "rimraf .next && next dev",
    "build": "next build",
    "build:clean": "rimraf .next && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "dotenv -e ../../.env.test -- vitest run",
    "test:unit:watch": "dotenv -e ../../.env.test -- vitest watch",
    "test:e2e": "playwright test",
    "test": "dotenv -e ../../.env.test -- vitest run",
    "db:migrate:test": "dotenv -e ../../.env.test -- prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:reset:test": "dotenv -e ../../.env.test -- prisma migrate reset --schema=../../prisma/schema.prisma --force --skip-seed",
    "db:seed:test": "dotenv -e ../../.env.test -- prisma db seed --schema=../../prisma/schema.prisma",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "mcp": "npx shadcn@latest mcp"
  },
  "dependencies": {
    "@alusa/lib": "workspace:*",
    "@alusa/ui": "workspace:*",
    "@heroicons/react": "2.1.5",
    "@hookform/resolvers": "3.9.0",
    "@prisma/client": "5.18.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-input-mask": "^3.0.6",
    "bcryptjs": "^2.4.3",
    "add": "^2.0.6",
    "cep-promise": "^4.4.1",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.555.0",
    "next": "14.2.5",
    "next-auth": "4.24.7",
    "pnpm": "^10.15.1",
    "qrcode.react": "^4.2.0",
    "react": "18.2.0",
    "react-currency-input-field": "^4.0.3",
    "react-day-picker": "^9.11.3",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.5.0",
    "react-hook-form": "7.53.0",
    "react-hot-toast": "^2.6.0",
    "react-imask": "^7.6.0",
    "react-input-mask": "^2.0.4",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.1.2",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "tailwind-variants": "^3.1.0",
    "twilio": "^5.10.2",
    "zod": "3.23.8",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@playwright/test": "1.46.1",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "8.6.14",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "16.0.0",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.22",
    "@types/bcryptjs": "2.4.6",
    "@vitest/coverage-v8": "1.6.0",
    "autoprefixer": "10.4.19",
    "cross-env": "^10.0.0",
    "eslint": "8.57.0",
    "postcss": "8.4.41",
    "prisma": "5.18.0",
    "rimraf": "^5.0.5",
    "shadcn": "^3.5.1",
    "storybook": "8.6.14",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vitest": "1.6.0"
  }
}
