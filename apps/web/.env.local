# Ambiente local específico da app web (carregado pelo Next.js nesta pasta)
# Copiado a partir da raiz e mantido coerente.

# URL pública usada pelo NextAuth (ajuste se mudar porta / domínio)
NEXTAUTH_URL=http://localhost:3000
# Segredo criptográfico NextAuth (mantido coerente com raiz / exemplo)
NEXTAUTH_SECRET=2queztXYjfC2T1H8i9fHEmifRIqvCfXVe6pocGJvYAE=

# Banco de dados (repete para garantir que getServerSide code enxergue variável dentro do app dir)
DATABASE_URL=postgresql://postgres:alusa@localhost:5432/alusa?schema=public

# Flags de debug
NEXT_PUBLIC_AUTH_DEBUG=0
AUTH_DEBUG=0

# Integração Asaas (SANDBOX)
