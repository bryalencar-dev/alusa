{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
  "baseUrl": ".",
    "types": [
      "node",
  "next",
      "@types/react",
      "@types/react-dom"
    ],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "jsx": "preserve",
  "paths": { "@/*": ["./*"] },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
  ".next/types/**/*.ts",
  "node_modules/lucide-react/dist/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "e2e"
  ]
}
