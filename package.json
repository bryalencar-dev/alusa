{
  "name": "alusa-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "pnpm -r exec eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",

    "build": "pnpm -r run build",
    "build:web": "pnpm -F @alusa/web build",
  "build:clean": "pnpm --filter @alusa/web build:clean",

    "dev": "pnpm --filter @alusa/ui build && pnpm --filter @alusa/lib build && pnpm --filter @alusa/web dev",
    "dev:web": "pnpm --filter @alusa/ui build && pnpm --filter @alusa/lib build && pnpm -F @alusa/web dev",
  "dev:clean": "pnpm --filter @alusa/web dev:clean",
    "dev:prisma": "pnpm dlx prisma studio",

    "test": "pnpm -r run test",
  "test:unit:all": "pnpm -r --filter ./apps/web run test:unit",
  "test:unit": "pnpm --filter @alusa/web run test:unit",
  "test:unit:watch": "pnpm --filter @alusa/web run test:unit:watch",
    "test:e2e": "pnpm -r --filter ./apps/web run test:e2e",

    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name init --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma --name matriculas",
    "db:migrate:matriculas": "prisma migrate dev --schema=prisma/schema.prisma --name matriculas",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:migrate:test": "pnpm --filter @alusa/web run db:migrate:test",
    "db:reset:test": "pnpm --filter @alusa/web run db:reset:test",
    "db:seed:test": "pnpm --filter @alusa/web run db:seed:test",
    "db:verify:test": "dotenv -e .env.test -- node scripts/verify-test-db.mjs"
  },
  "devDependencies": {
    "@prisma/client": "5.18.0",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "16.0.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.9",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "1.6.0",
    "bcryptjs": "2.4.3",
    "dotenv-cli": "7.4.1",
    "eslint": "9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "3.3.3",
    "prisma": "5.18.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsx": "4.19.1",
    "turbo": "2.0.6",
    "typescript": "5.5.4",
    "typescript-eslint": "8.41.0",
    "vitest": "1.6.0",
    "zod": "3.23.8"
  },
  "pnpm": {
    "overrides": {}
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "cep-promise": "^4.4.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
