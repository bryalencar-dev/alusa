FEATURE_ASAAS=true

# Observações:
# - Altere NEXTAUTH_SECRET para um valor forte em produção (ex: `openssl rand -base64 32`).
# - Mantenha NEXTAUTH_URL coerente com o domínio público (https em produção).
# - Ative DEBUG apenas localmente quando precisar investigar fluxo de login/redirect.
# - ASAAS_API_KEY: obtenha sua chave no painel Asaas > Integrações > API Key (sandbox)
# - ASAAS_WEBHOOK_SECRET: segredo usado para validar assinatura dos webhooks (gere com `openssl rand -hex 32`)
# - FEATURE_ASAAS: controla se a integração está ativa (true/false)
