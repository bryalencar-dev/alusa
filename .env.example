# Asaas (Pagamentos)
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# ⚠️ IMPORTANTE: Use aspas duplas se a chave começar com $ (evita interpretação como variável)
ASAAS_API_KEY="$aact_hmlg_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6OjZmNjkzMGU4LWY4MGEtNDg3MS1hYjBkLWY5NDJmMzZiMWM2Njo6JGFhY2hfZTEwYmFhODQtNDU4MS00ZWFiLWIzYWItMThkNjIxYmM5ZmU0"
