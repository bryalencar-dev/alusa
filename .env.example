# Banco de dados PostgreSQL local
DATABASE_URL="postgresql://postgres:alusa@localhost:5432/alusa?schema=public"

# Node env
NODE_ENV=development

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="2queztXYjfC2T1H8i9fHEmifRIqvCfXVe6pocGJvYAE="

# Debug de autenticação (0 desliga, 1 liga logs detalhados em client e server)
